# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.log

# Contenu édité via le back-office (overrides JSON, photo, messages)
.data

# ── Environnement de travail local (jamais publiés) ──
# Secrets du back-office : production = variables d'environnement uniquement
/config/
# Fichiers déposés / générés en session
/upload/
/tool-results/
/agent-ctx/
/download/
# Base de données locale (binaires)
/db/*.db
/db/*.db-journal

# Artéfacts d'infrastructure de prévisualisation (gérés par la plateforme)
/.zscripts/
/tests/
/skills/
/Caddyfile
/mini-services/
